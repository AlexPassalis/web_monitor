#!/usr/bin/env bash
set -euo pipefail

SERVICE_NAME="web_monitor_backend"

if ! docker service ps "$SERVICE_NAME" -q 2>/dev/null | grep -q .; then
    echo "\"$SERVICE_NAME\" service is not running."
    make start
fi

if tty -s; then
    USE_TTY="-it"
else
    USE_TTY="-i"
fi

CONTAINER_ID=$(docker ps -q -f "name=${SERVICE_NAME}" | head -n 1)

docker exec $USE_TTY "$CONTAINER_ID" "$@"
