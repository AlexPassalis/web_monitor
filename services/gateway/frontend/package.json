{
  "name": "frontend",
  "version": "0.1.0",
  "engines": {
    "bun": "1.3.5"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bunx eslint src --ext .ts,.tsx",
    "fix": "bunx eslint src --ext .ts,.tsx --fix",
    "check": "bunx tsc --noEmit",
    "openapi": "npx openapi-typescript http://localhost:8000/api/openapi.json -o ./src/lib/openapi/schema.d.ts",
    "test": "bunx playwright test",
    "dev": "bun --hot src/index.ts",
    "build": "bun run build.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "~0.1.2",
    "openapi-fetch": "~0.15.0",
    "react": "~19.2.3",
    "react-dom": "~19.2.3",
    "react-router-dom": "~7.11.0",
    "tailwindcss": "~4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.2",
    "@faker-js/faker": "~10.1.0",
    "@playwright/test": "~1.55.0",
    "@types/bun": "~1.3.5",
    "@types/react": "~19.2.3",
    "@types/react-dom": "~19.2.3",
    "eslint": "~9.39.2",
    "eslint-plugin-react": "~7.37.5",
    "globals": "~16.5.0",
    "jiti": "~2.6.1",
    "openapi-typescript": "~7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.50.0"
  }
}
