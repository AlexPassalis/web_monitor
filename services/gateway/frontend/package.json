{
  "name": "frontend",
  "version": "0.1.0",
  "engines": {
    "bun": "1.3.5"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bunx eslint src --ext .ts,.tsx",
    "fix": "bunx eslint src --ext .ts,.tsx --fix",
    "check": "bunx tsc --noEmit",
    "openapi": "npx openapi-typescript http://localhost:8000/api/openapi.json -o ./src/lib/openapi/schema.d.ts",
    "dev": "bun --hot src/index.ts",
    "test": "bunx playwright test",
    "build": "bun build src/main.tsx --outdir=dist --target=browser --format=iife --minify --sourcemap=linked --plugins=bun-plugin-tailwind"
  },
  "dependencies": {
    "@mantine/carousel": "~8.3.10",
    "@mantine/core": "~8.3.10",
    "@mantine/form": "~8.3.10",
    "@mantine/hooks": "~8.3.10",
    "@mantine/notifications": "^8.3.10",
    "bun-plugin-tailwind": "~0.1.2",
    "embla-carousel": "~8.5.2",
    "embla-carousel-react": "~8.5.2",
    "mantine-form-zod-resolver": "~1.3.0",
    "openapi-fetch": "~0.15.0",
    "react": "~19.2.3",
    "react-dom": "~19.2.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "~7.11.0",
    "tailwindcss": "~4.1.11",
    "zod": "~4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.2",
    "@faker-js/faker": "~10.1.0",
    "@playwright/test": "~1.55.0",
    "@types/bun": "~1.3.5",
    "@types/react": "~19.2.3",
    "@types/react-dom": "~19.2.3",
    "eslint": "~9.39.2",
    "eslint-plugin-react": "~7.37.5",
    "globals": "~16.5.0",
    "jiti": "~2.6.1",
    "openapi-typescript": "~7.10.1",
    "postcss": "~8.5.6",
    "postcss-preset-mantine": "~1.18.0",
    "postcss-simple-vars": "~7.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.50.0"
  }
}
