{
  "name": "frontend",
  "version": "0.1.0",
  "engines": {
    "bun": "1.3.5"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "bunx eslint src --ext .ts,.tsx",
    "check": "bunx tsc --noEmit",
    "dev": "bun --hot src/index.ts",
    "build": "bun run build.ts",
    "start": "bun src/index.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.11.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "typescript-eslint": "^8.50.0"
  }
}
